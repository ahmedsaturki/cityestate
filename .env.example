# =============================================================================
# CityEstate — Environment Configuration Template
# =============================================================================
# DO NOT commit a populated .env. Generate it with:
#     python scripts/bootstrap_env.py
# To rotate specific secrets:
#     python scripts/bootstrap_env.py --rotate JWT_SECRET ADMIN_PASSWORD
# To rotate everything:
#     python scripts/bootstrap_env.py --rotate
# =============================================================================

# External provider keys — required at bootstrap time.
# ROTATE THESE at the provider before generating a new .env if the old one leaked.
ROUTER_API_KEY=<paste-openrouter-key-here>
ROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_MODEL=inclusionai/ling-3.0-flash:free
JINA_API_KEY=<paste-jina-key-here>

# Local database (SQLite default; switch to postgres for production).
DATABASE_URL=sqlite:///output/cityestate.db

# Auto-generated local secrets — never set these by hand.
# JWT_SECRET — HS256 signing key for auth tokens.
# SESSION_VAULT_KEY — Fernet key used by EncryptionManager for at-rest secrets.
# PASSWORD_SALT — reserved for future password derivation; bcrypt currently
#                  uses its own internal per-hash salt, so this key is a no-op
#                  kept for compatibility. Safe to leave unset.
# ADMIN_PASSWORD — initial admin login. Rotate after first login.
# EXTENSION_SHARED_SECRET — shared secret for the Chrome extension auto-auth
#                          handshake. Generate a unique >= 32 char random value.
#                          Paste the same value into the extension popup on
#                          first install. DO NOT reuse ADMIN_PASSWORD.
JWT_SECRET=GENERATE_VIA_BOOTSTRAP
SESSION_VAULT_KEY=GENERATE_VIA_BOOTSTRAP
PASSWORD_SALT=
ADMIN_PASSWORD=GENERATE_VIA_BOOTSTRAP
EXTENSION_SHARED_SECRET=GENERATE_VIA_BOOTSTRAP

# CORS — comma-separated. Use exact origins, no wildcards.
ALLOWED_ORIGINS=http://localhost:8050,http://localhost:3000
API_VERSION=v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# Maximum request body size in bytes (default 1 MB).
# Increase for large file uploads; decrease for stricter limits.
MAX_REQUEST_SIZE=1048576

# Form-provider webhook secrets (HMAC-SHA256).
# One per provider: WEBHOOK_SECRET_TALLY, WEBHOOK_SECRET_TYPEFORM,
# WEBHOOK_SECRET_GOOGLE_FORMS, etc.
# The provider sends the secret in the `X-Webhook-Signature` header.
# If no WEBHOOK_SECRET_* is set, /webhooks/form returns 503.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
# WEBHOOK_SECRET_TALLY=

# Webhooks — set only when you have a webhook receiver.
# WEBHOOK_SECRET_TEST is referenced by tests/test_webhook_hmac.py.
WEBHOOK_SECRET_TEST=

# Auth — token lifetime in hours. Default 8; reduce to 1 for high-trust envs,
# raise to 24 for low-friction internal tools.
JWT_EXPIRY_HOURS=8

# Legacy password hashing — DO NOT enable unless you are migrating old
# password hashes. New passwords always use bcrypt's per-hash salt.
# Set to "1" only if a pre-rotation deployment needs verify_password() to
# accept hashes created with the legacy SHA256(PASSWORD_SALT + pw) scheme.
USE_LEGACY_SALT=

# Logging — directory for rotating log files. Defaults to ./logs relative
# to the project root if unset.
LOG_DIR=

# API surface — disable Swagger UI/Redoc in production by setting "false".
# Default is "true" so docs are visible in dev.
ENABLE_DOCS=true

# Dashboard — where the Streamlit dashboard should reach the API. Used by
# src/dashboard/app.py. Default http://localhost:8000.
API_BASE_URL=http://localhost:8000

# Local LLM fallback — used when ROUTER_API_KEY is unavailable. Optional.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI — only required for STT/TTS via src/skills/voice_speech.py. Leave
# blank if not using voice features.
OPENAI_API_KEY=

# SMTP — used by src/skills/email_skill.py. Leave blank to disable outbound
# email.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Project root override — only set this if running backups from outside the
# project directory. Most installs leave this unset.
PROJECT_ROOT=

# ----------------------------------------------------------------------
# Auto-managed by loader.py — DO NOT edit by hand. bootstrap_env.py will
# set/refresh these at every run. Listed here only for transparency.
# ----------------------------------------------------------------------
# OPENROUTER_API_KEY=mirrors ROUTER_API_KEY (set by loader)
# OTEL_SDK_DISABLED=true (forced by loader)
# OTEL_TRACES_EXPORTER=none (forced by loader)
# OTEL_METRICS_EXPORTER=none (forced by loader)
# OTEL_LOGS_EXPORTER=none (forced by loader)
